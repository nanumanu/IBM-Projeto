# Copie para .env e troque as chaves antes de publicar
DATABASE_URL=sqlite:///./safeone.db
# PostgreSQL (IBM Cloud Databases): postgresql+psycopg://usuario:senha@host:porta/banco?sslmode=require

AGENT_API_KEY=troque-esta-chave-de-agente
ANALYST_API_KEY=troque-esta-chave-de-analista
PUBLIC_URL=http://localhost:8080

CASE_THRESHOLD=60
WINDOW_HOURS=2
SEED_ON_STARTUP=true

# Opcional: narrativa do dossiê pelo watsonx.ai (sem isso, usa texto de template)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
